{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "types": ["node", "jest"],
    "sourceMap": true
  },
  "include": ["apps/api/src/**/*.ts", "apps/worker/src/**/*.ts", "libs/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist", "apps/web"]
}
