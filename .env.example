# Local development only. Copy to .env and replace credentials.
NODE_ENV=development
API_PORT=3000
WEB_ORIGIN=http://127.0.0.1:5173
POSTGRES_USER=rms
POSTGRES_PASSWORD=local_rms_password
POSTGRES_DB=recruitment
POSTGRES_PORT=5432
DATABASE_URL=postgresql://rms:local_rms_password@127.0.0.1:5432/recruitment?schema=public
MINIO_ROOT_USER=rms_local
MINIO_ROOT_PASSWORD=local_minio_password
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=rms-cv
S3_ACCESS_KEY_ID=rms_local
S3_SECRET_ACCESS_KEY=local_minio_password
S3_FORCE_PATH_STYLE=true
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=noreply@example.test
SCANNER_HOST=127.0.0.1
SCANNER_PORT=3310
# Supply private provider settings during video implementation.
JITSI_DOMAIN=
JITSI_APP_ID=
JITSI_APP_SECRET=
SESSION_SECRET=replace_before_implementing_auth
E2E_BASE_URL=http://127.0.0.1:5173

# Auth secrets: replace before production; 32+ byte CSRF/session secrets.
CSRF_SECRET=replace_before_implementing_csrf
# Generate a private 32-byte hex key; required in production.
AUTH_TOKEN_ENCRYPTION_KEY=
